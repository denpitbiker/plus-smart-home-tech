@namespace("ru.yandex.practicum.kafka.telemetry.event")
protocol SensorEventProtocol {
    record ClimateSensorAvro { int temperature_c; int humidity; int co2_level; }
    record LightSensorAvro { int link_quality; int luminosity; }
    record MotionSensorAvro { int link_quality; boolean motion; int voltage; }
    record SwitchSensorAvro { boolean state; }
    // The assignment intentionally repeats metadata here; bundled Hub Router differs.
    record TemperatureSensorAvro {
        string id;
        string hubId;
        timestamp_ms timestamp;
        int temperature_c;
        int temperature_f;
    }
    record SensorEventAvro {
        string id;
        string hubId;
        timestamp_ms timestamp;
        union { ClimateSensorAvro, LightSensorAvro, MotionSensorAvro, SwitchSensorAvro, TemperatureSensorAvro } payload;
    }
}
